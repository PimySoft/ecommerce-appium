{
  "name": "e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Appium + WebdriverIO E2E suite for the SHOP-101 coupon feature on a React Native shop app",
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24"
  },
  "scripts": {
    "test:ios": "wdio run ./wdio.ios.conf.ts",
    "test:android": "wdio run ./wdio.android.conf.ts",
    "test:api": "mocha --require ./api/register.cjs --reporter ./api/resultsReporter.cjs --extension ts --timeout 15000 \"api/**/*.api.spec.ts\"",
    "test:unit": "mocha --require ./api/register.cjs --extension ts \"unit/**/*.test.ts\"",
    "test:report": "node -r ./api/register.cjs scripts/defect-report.ts",
    "test:table": "node -r ./api/register.cjs scripts/results-table.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.3",
    "@wdio/appium-service": "^9.31.9",
    "@wdio/cli": "^9.31.9",
    "@wdio/junit-reporter": "^9.31.2",
    "@wdio/local-runner": "^9.31.9",
    "@wdio/mocha-framework": "^9.31.9",
    "@wdio/reporter": "^9.31.2",
    "@wdio/spec-reporter": "^9.31.2",
    "appium": "3.1.2",
    "chai": "^4.5.0",
    "eslint": "^9.39.5",
    "prettier": "3.9.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "webdriverio": "^9.31.9"
  }
}
